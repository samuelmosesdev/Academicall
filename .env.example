# Copy this file to .env.local and fill in values from your Firebase project
# Firebase Console -> Project settings -> General -> Your apps -> SDK setup and config
#
# IMPORTANT: use a SEPARATE Firebase project for local development.
# Vite loads .env.development for `npm run dev` and .env.production for
# `npm run build`, so point them at different projects. Pointing dev at the
# production project means every hot reload, test signup and stray listener
# bills against the live quota. See docs/FIRESTORE-COST-POSTMORTEM.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web push (optional). Leave blank to disable FCM registration entirely.
VITE_FIREBASE_VAPID_KEY=

# Local development against the Firebase emulator suite.
# Set to "true" and run `firebase emulators:start` to keep dev traffic off any
# real project. Overrides the config above for Firestore, Auth and Storage.
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
