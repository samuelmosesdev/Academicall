# Copy this file to .env.local and fill in values from your Firebase project
# Firebase Console -> Project settings -> General -> Your apps -> SDK setup and config
#
# IMPORTANT: try not to develop against the production Firebase project. Every
# hot reload, test signup and stray listener bills against the live quota.
# The app prints a loud console warning when a dev build connects to production.
#
# To develop against the local emulator suite instead:
#   cp .env.development.example .env.development.local
# That file is gitignored and mode-specific, so it overrides the values here
# for `npm run dev` only, and only for you. See
# docs/FIRESTORE-COST-POSTMORTEM.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web push (optional). Leave blank to disable FCM registration entirely.
VITE_FIREBASE_VAPID_KEY=

# Local development against the Firebase emulator suite.
# Set to "true" and run `firebase emulators:start` to keep dev traffic off any
# real project. Overrides the config above for Firestore, Auth and Storage.
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
