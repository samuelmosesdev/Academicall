# Copy this file to .env.local and fill in your values.

# Academicall API — your Express + Postgres backend. This is the source of
# truth for auth and all app data.
VITE_API_URL=http://localhost:4000/api/v1

# Google Identity Services client ID (Google Cloud Console -> Credentials ->
# OAuth 2.0 Client ID -> Web application). Used for "Sign in with Google"
# without Firebase Auth. Leave blank to hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=

# Firebase is used ONLY for optional web push notifications (FCM) on the
# frontend now. Leave all of these blank to disable push entirely — nothing
# else in the app depends on Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Cloudinary (document/avatar uploads)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
