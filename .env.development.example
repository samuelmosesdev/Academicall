# OPT-IN local emulator config. This file is a template and is NOT loaded by
# Vite — nothing here affects you until you copy it:
#
#     cp .env.development.example .env.development.local
#     npm run emulators      # in one terminal (needs JDK 21+)
#     npm run seed           # once, to create test users + sample data
#     npm run dev            # in another terminal
#
# .env.development.local is gitignored, so this stays a personal choice. Delete
# it and `npm run dev` goes straight back to whatever is in your .env.local.
#
# WHY THIS IS OPT-IN RATHER THAN THE DEFAULT
# Vite loads env files as:
#     .env -> .env.local -> .env.[mode] -> .env.[mode].local
# with later files winning. A committed `.env.development` would therefore
# silently override every developer's personal `.env.local` credentials, and
# anyone who pulled without reading the changelog would get an app that fails
# to reach Firestore with no obvious cause. Not worth it. See
# docs/FIRESTORE-COST-POSTMORTEM.md.
#
# The "demo-" project prefix makes the emulator refuse to contact any real
# Google backend, so a misconfiguration fails loudly instead of quietly billing
# the production quota.

VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-uofa-reader.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-uofa-reader
VITE_FIREBASE_STORAGE_BUCKET=demo-uofa-reader.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo

# Blank so FCM registration is skipped entirely against the emulator.
VITE_FIREBASE_VAPID_KEY=

# Don't call the live Brevo verification function from local dev.
VITE_VERIFY_API_URL=
