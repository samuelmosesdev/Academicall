# Local development defaults — SAFE TO COMMIT (contains no real credentials).
#
# Vite loads env files in this order, with later files overriding earlier ones:
#   .env  ->  .env.local  ->  .env.development  ->  .env.development.local
#
# Because .env.development is mode-specific it outranks .env.local, so these
# values win during `npm run dev` even though .env.local holds the production
# credentials. That is deliberate: local development must not touch the live
# project. See docs/FIRESTORE-COST-POSTMORTEM.md.
#
# The "demo-" project prefix makes the Firebase emulator refuse to contact any
# real Google backend, so a misconfiguration fails loudly instead of silently
# billing production.

VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-uofa-reader.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-uofa-reader
VITE_FIREBASE_STORAGE_BUCKET=demo-uofa-reader.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo

# Leave blank so FCM registration is skipped entirely against the emulator.
VITE_FIREBASE_VAPID_KEY=

# Don't call the live Brevo verification function from local dev.
VITE_VERIFY_API_URL=
